# Turso Database Credentials
TURSO_DATABASE_URL="libsql://your-db-name-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-jwt"

# PayPal Payment Provider Configuration
# Get your Client ID and Secret from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID="your_paypal_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret_here"
PAYPAL_MODE="sandbox" # Options: sandbox | live
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"
NEXT_PUBLIC_APP_URL="https://exultia.tech"
# Pre-Launch Operator Validation & Access Control
# Set PRIVATE_VALIDATION_MODE="true" to restrict all sign-ins and registrations to authorized operators.
# Set PRIVATE_VALIDATION_MODE="false" or PUBLIC_LAUNCH="true" when launching the site publicly.
PRIVATE_VALIDATION_MODE="true"
AUTHORIZED_EMAILS="admin@exultia.tech,your_email@example.com"

# Private Preview & Operator Gate (Hides Entire Site from Public)
# Set PRIVATE_PREVIEW_MODE="true" to redirect all visitors to the /preview holding page unless authorized.
PRIVATE_PREVIEW_MODE="true"
OPERATOR_PREVIEW_KEY="exultia-preview-2026"

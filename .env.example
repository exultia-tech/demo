# Turso Database Credentials
TURSO_DATABASE_URL="libsql://your-db-name-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-jwt"

# PayPal Payment Provider Configuration
# Get your Client ID and Secret from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID="your_paypal_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret_here"
PAYPAL_MODE="sandbox" # Options: sandbox | live
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"
NEXT_PUBLIC_APP_URL="https://exultia.tech"

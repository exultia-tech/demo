# -----------------------------------------------------------------------------
# Exultia Production Deployment Configuration
# -----------------------------------------------------------------------------

# Canonical Production URL
NEXT_PUBLIC_APP_URL="https://exultia.tech"

# 1. Database (Turso / LibSQL)
# Required for user accounts, subscriptions, licenses, and threat cache
TURSO_DATABASE_URL="libsql://your-db-name-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-jwt"

# 2. Public Launch vs Private Preview Gate
# Set PUBLIC_LAUNCH="true" (or PRIVATE_PREVIEW_MODE="false") to deploy live to the public.
# Set PRIVATE_PREVIEW_MODE="true" to keep the site gated behind the /preview holding page.
PUBLIC_LAUNCH="true"
PRIVATE_PREVIEW_MODE="false"
OPERATOR_PREVIEW_KEY="exultia-preview-2026"

# 3. User Registration & Access Control
# Set PRIVATE_VALIDATION_MODE="false" when ready for open public registrations.
# If "true", sign-ups and logins are restricted to AUTHORIZED_EMAILS.
PRIVATE_VALIDATION_MODE="false"
AUTHORIZED_EMAILS="admin@exultia.tech,your_email@example.com"

# 4. PayPal Payment Provider Configuration
# Get your Client ID and Secret from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID="your_paypal_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret_here"
PAYPAL_MODE="sandbox" # Options: sandbox | live
PAYPAL_WEBHOOK_ID=""

# 5. GitHub Actions Cloud IDE Builder
# Required for triggering automated PureIDE/SecureIDE compiler builds on GitHub Actions
GITHUB_TOKEN="your_github_personal_access_token_or_pat"
GITHUB_OWNER="wstrika"
GITHUB_REPO="exultia"
GITHUB_WORKFLOW="build-ide.yml"

# 6. Site Mode Toggles (Optional)
# Set to "true" to lock the UI strictly into Vantage Threat Feed mode
NEXT_PUBLIC_ISOLATED_THREAT_FEED="false"

# 7. Automated Threat Advisory Bot (Optional, manual or cron run)
BLUESKY_IDENTIFIER="exultia-tech.bsky.social"
BLUESKY_PASSWORD="your-bluesky-app-password"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
DEVTO_API_KEY=""


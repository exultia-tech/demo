# =============================================================================
# SecureIDE Environment Configuration
# =============================================================================

# GitHub Actions Orchestration (Set these when you connect your GitHub repository)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenOrFineGrainedToken
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=secure-ide
GITHUB_WORKFLOW=build-ide.yml

# Optional: Cloudflare R2 / AWS S3 Storage for long-term distribution hosting
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
